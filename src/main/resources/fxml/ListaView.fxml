<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.um.pds.trello.infrastructure.javafx.ListaControlador">
    
    <VBox spacing="5.0">
        <Label style="-fx-font-weight: bold;" text="Nombre de la lista:" />
        <TextField fx:id="txtNombreLista" promptText="Ej: Tareas terminadas" />
    </VBox>

    <VBox spacing="5.0">
        <Label style="-fx-font-weight: bold;" text="Límite máximo de tarjetas (opcional):" />
        <TextField fx:id="txtLimite" promptText="Ej: 5 (deja vacío para sin límite)" />
    </VBox>

    <CheckBox fx:id="chkEsCompletada" text="¿Es lista de completadas?" />

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button onAction="#handleCancelar" text="Cancelar" />
        <Button onAction="#handleCrear" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" text="Crear Lista" />
    </HBox>
    
</VBox>