<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="500.0" prefWidth="400.0" spacing="10.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <Label text="Historial de actividad">
        <font>
            <Font name="System Bold" size="16.0" />
        </font>
    </Label>
    
    <Separator />

    <ListView fx:id="listaTrazas" VBox.vgrow="ALWAYS">
        </ListView>

    <HBox alignment="CENTER_RIGHT">
        <Button text="Cerrar" />
    </HBox>
</VBox>